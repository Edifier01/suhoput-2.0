[Unit]
Description=Suhoput STAGE-B full backup control
Requires=docker.service
After=docker.service time-sync.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@@ROOT@@/backup
ExecStart=/usr/bin/python3 @@ROOT@@/backup/bin/worker.py --config @@ROOT@@/backup/config/runtime.json full
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=768M
TasksMax=128
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@ROOT@@/backup
StandardOutput=journal
StandardError=journal
